# =============================================================================
# Example: configure OpenRouter with MULTIPLE models, one per risk level.
#
# Copy the lines you want into your real `.env` (gitignored). The idea: route
# cheap/low-risk tasks to cheap models and hard/critical tasks to strong ones —
# all through a single OpenRouter key — and optionally keep the very hardest
# work on your Claude subscription.
#
# After editing `.env`, verify what got picked up:
#   ai-os llm list
# The per-task routing (provider -> model) is shown in the plan table before you
# approve a run: `ai-os epic run <project> --prompt "..." --language python`.
#
# NOTE: the model SLUGS below are illustrative — check the current catalog +
# pricing at https://openrouter.ai/models (slugs and availability change). The
# risk->model matrix never goes stale on a rename because it's just env config.
# =============================================================================

# --- 1. The OpenRouter credential --------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
# Optional attribution (shows your app on OpenRouter's leaderboards):
OPENROUTER_APP_TITLE=ai-os
# OPENROUTER_SITE_URL=https://your-site.example
# A fallback model for any task that doesn't get an explicit per-risk model below
# (OpenRouter has no built-in default — without this OR the matrix, it errors):
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4.5

# --- 2. A MODEL per risk level (the multi-model part) ------------------------
# LOW      = trivial edits, boilerplate, docs           -> cheapest
# MEDIUM   = normal feature work                        -> cheap-but-capable
# HIGH     = tricky logic, cross-cutting changes        -> strong
# CRITICAL = architecture, decomposition/planning       -> strongest
AI_OS_MODEL_OPENROUTER_LOW=google/gemini-2.5-flash-lite
AI_OS_MODEL_OPENROUTER_MEDIUM=deepseek/deepseek-chat
AI_OS_MODEL_OPENROUTER_HIGH=anthropic/claude-sonnet-4.5
AI_OS_MODEL_OPENROUTER_CRITICAL=anthropic/claude-opus-4.1

# --- 3. Make OpenRouter actually HANDLE those levels -------------------------
# The matrix above only picks the model *within* a provider; this picks the
# provider per level (first configured one wins, left to right). Send everything
# to OpenRouter here. (Swap in `anthropic` first on CRITICAL if you'd rather run
# the hardest work on your Claude subscription — see the two commented lines.)
AI_OS_PROVIDER_ORDER_LOW=openrouter
AI_OS_PROVIDER_ORDER_MEDIUM=openrouter
AI_OS_PROVIDER_ORDER_HIGH=openrouter,anthropic
AI_OS_PROVIDER_ORDER_CRITICAL=openrouter,anthropic
# Prefer your Claude subscription for the hardest tasks, OpenRouter as fallback:
# AI_OS_PROVIDER_ORDER_HIGH=anthropic,openrouter
# AI_OS_PROVIDER_ORDER_CRITICAL=anthropic,openrouter

# --- 4. Safety rails (optional) ----------------------------------------------
# On an HTTP 429, a task backs off (honoring Retry-After) up to N times before
# falling back to the NEXT provider in the order above:
AI_OS_RATE_LIMIT_RETRIES=3
# Hard per-epic USD cap: once recorded spend hits this, the run stops and the
# remaining tasks are marked SKIPPED. Great while dialing in a new model mix:
AI_OS_EPIC_BUDGET_USD=2.00

# --- 5. (Optional) mix providers instead of OpenRouter-only ------------------
# You can combine OpenRouter with Gemini's own key and your Claude subscription.
# For example: cheap tasks on Gemini's native API, mid on OpenRouter, hard on
# Claude — just configure each provider and set the order per level accordingly.
# GEMINI_API_KEY=AIzaSy...
# AI_OS_PROVIDER_ORDER_LOW=gemini,openrouter
# AI_OS_PROVIDER_ORDER_MEDIUM=openrouter,gemini
# AI_OS_PROVIDER_ORDER_HIGH=anthropic,openrouter
# AI_OS_PROVIDER_ORDER_CRITICAL=anthropic

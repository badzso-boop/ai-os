# ==============================================================================
# AI-OS Phase 3a — MCP Provider Adapter Configuration
#
# Copy this file to `.env` and fill in what you actually have:
#   cp .env.example .env
#
# `.env` itself is gitignored — never commit real credentials. Every value
# below is optional; only providers with real credentials present get
# configured (see `ai-os llm list`). No web-session/cookie auth is supported
# for any provider — see CLAUDE.md for why.
# ==============================================================================

# --- Anthropic Claude ---------------------------------------------------------
# ANTHROPIC_MODE=session|api_key
#   "session" (default if the `claude` CLI is found on PATH): reuses your
#     existing Claude Code browser-login subscription via `claude -p ...`.
#     No API key needed for this mode.
#   "api_key": standard pay-per-token Developer API instead of your
#     subscription's included usage.
# ANTHROPIC_MODE=session
# ANTHROPIC_API_KEY=sk-ant-api03-...
# ANTHROPIC_CLI=claude   # override only if the `claude` binary has a different name on PATH

# --- Google Gemini (AI Studio developer API key only) -------------------------
# Get one at https://aistudio.google.com -> "Get API key".
# GEMINI_API_KEY=AIzaSy...

# --- OpenRouter (many providers/models behind one key) ------------------------
# Register at https://openrouter.ai -> Settings -> Keys.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_DEFAULT_MODEL=       # optional, e.g. anthropic/claude-sonnet-4.5 — can also pass --model per call
# OPENROUTER_SITE_URL=            # optional, OpenRouter attribution/leaderboard
# OPENROUTER_APP_TITLE=ai-os      # optional, OpenRouter attribution/leaderboard

# ==============================================================================
# AI-OS Phase 4a — Risk -> Model routing (ai-os epic run)
#
# When `ai-os epic run` decomposes a request into tasks, each task's risk_level
# picks a provider (first configured one, in preference order) AND a model
# WITHIN that provider. Defaults below; override any cell as needed. A value
# left unset means "use that provider's own default model".
#
# Anthropic defaults (CLI-session aliases — always resolve to the current
# release, so they never go stale): LOW=haiku, MEDIUM/HIGH=sonnet, CRITICAL=opus.
# AI_OS_MODEL_ANTHROPIC_LOW=haiku
# AI_OS_MODEL_ANTHROPIC_MEDIUM=sonnet
# AI_OS_MODEL_ANTHROPIC_HIGH=sonnet
# AI_OS_MODEL_ANTHROPIC_CRITICAL=opus
#
# Gemini: unset -> the adapter's own default model. Override per risk if you
# want cheaper/stronger Gemini tiers per task:
# AI_OS_MODEL_GEMINI_LOW=gemini-flash-lite
# AI_OS_MODEL_GEMINI_CRITICAL=gemini-pro
#
# OpenRouter has NO safe default model — to route any risk level to OpenRouter
# you must name a model here (or set OPENROUTER_DEFAULT_MODEL above):
# AI_OS_MODEL_OPENROUTER_LOW=google/gemini-flash-1.5
# AI_OS_MODEL_OPENROUTER_HIGH=anthropic/claude-sonnet-4.5

# --- Which PROVIDER handles each risk level (order of preference) -------------
# Comma-separated provider names, tried left to right; the first one that's
# actually configured wins (an unconfigured/typo'd name is skipped, never an
# error). Unset -> the built-in cost-tuned defaults:
#   LOW      = gemini, openrouter, anthropic
#   MEDIUM   = openrouter, gemini, anthropic
#   HIGH     = anthropic, openrouter
#   CRITICAL = anthropic
# Example: send LOW+MEDIUM to OpenRouter's cheap models, keep the hard stuff on
# your Claude subscription:
# AI_OS_PROVIDER_ORDER_LOW=openrouter,anthropic
# AI_OS_PROVIDER_ORDER_MEDIUM=openrouter,anthropic
# AI_OS_PROVIDER_ORDER_HIGH=anthropic
# AI_OS_PROVIDER_ORDER_CRITICAL=anthropic

# ==============================================================================
# AI-OS Phase 5 Stage 4 — Adaptive rate-limit + cost-aware scheduling
#
# Rate-limit backoff + provider fallback are ALWAYS on for `ai-os epic run`:
# on an HTTP 429 the task backs off (honoring Retry-After, else exponential)
# and, if a provider keeps throttling, falls back to the next configured
# provider in that risk level's order (above). Both settings below are optional.
#
# How many times to retry the SAME provider on 429 before falling back (default 3):
# AI_OS_RATE_LIMIT_RETRIES=3
#
# Optional hard cost cap PER EPIC (USD). Before each batch, the epic's recorded
# spend (from the TokenCost table) is checked; once it reaches this cap the run
# stops and the remaining tasks are marked SKIPPED. Unset -> no cap.
# AI_OS_EPIC_BUDGET_USD=5.00
